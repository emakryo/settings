{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'export PATH=\"$HOME/.local/share/mise/shims:$PATH\"' >> \"$CLAUDE_ENV_FILE\""
          }
        ]
      }
    ]
  },
  "language": "日本語",
  "alwaysThinkingEnabled": true,
  "permissions": {
    "allow": [
      "Bash(gh run view:*)"
    ]
  }
}
